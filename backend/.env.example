# ──────────────────────────────────────────────────────────────────────────
# Existing — required
# ──────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here

# ──────────────────────────────────────────────────────────────────────────
# v1.3.0 — Hugging Face stack (Phases 1–4)
# All keys are optional with sensible defaults. Override only what you need.
# ──────────────────────────────────────────────────────────────────────────

# === Phase 1 — Embeddings ===
# Provider: "hf" (default, BGE) | "minilm" (legacy fallback for rollback)
EMBEDDING_PROVIDER=hf
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=auto                 # auto -> mps if available, else cpu
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true             # cosine on unit vectors
EMBEDDING_DIMENSION=768               # asserted at startup; mismatch logs a warning
EMBEDDING_USE_QUERY_INSTRUCTION=false # bge-v1.5 has only minor degradation without
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 

# === Phase 2 — Reranker ===
RERANKING_ENABLED=true
RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RERANKING_DEVICE=auto                 # auto -> mps if available, else cpu
RERANKING_USE_FP16=true               # only used when device=mps
RERANKING_TOP_N=30                    # candidates fetched from dense retrieval
RERANKING_TOP_K=8                     # candidates kept after rerank
RERANKING_MAX_LENGTH=512
RERANKING_BLEND_ALPHA=0.7             # combined = alpha*sigmoid(rerank) + (1-alpha)*retrieval
RERANKING_TIMEOUT_MS=2500             # soft warning threshold; fail-open still applies
RERANKING_FAIL_OPEN=true

# === Phase 3 — Clinical NER (retrieval enrichment ONLY) ===
CLINICAL_NER_ENABLED=false            # OFF by default; enable when you want enrichment
CLINICAL_NER_MODEL=d4data/biomedical-ner-all
CLINICAL_NER_DEVICE=cpu
CLINICAL_NER_MIN_SCORE=0.70
CLINICAL_NER_MAX_ENTITIES=12
CLINICAL_NER_ROLE=enrichment          # IMMUTABLE — any other value raises at startup

# === Phase 4 — Confidence with HF signals ===
CONFIDENCE_INCLUDE_HF_SIGNALS=true
CONFIDENCE_RERANKER_AGREEMENT_WEIGHT=0.15
CONFIDENCE_SEMANTIC_ALIGNMENT_WEIGHT=0.20

# === Phase 5 — Eval (only used by the eval harness) ===
EVAL_OUTPUT_DIR=backend/eval/results
EVAL_QUERY_TIMEOUT_S=30

# === Production safety / runtime ===
HF_HOME=./backend/.hf_cache
TRANSFORMERS_OFFLINE=0                # set to 1 after first download for air-gapped runs
PYTORCH_ENABLE_MPS_FALLBACK=1         # silently fall back to CPU for unsupported MPS ops
TOKENIZERS_PARALLELISM=false
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_PROGRESS_BARS=1
